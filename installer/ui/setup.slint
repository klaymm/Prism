import { Theme } from "@prism/theme.slint";
import { Icons } from "@prism/icons.slint";
import { Button, ButtonKind, Icon, Label, Spinner, Switch } from "@prism/controls.slint";
import { PopShadow } from "@prism/overlays.slint";
import { AnimatedLogo, CaptionButtons, DragArea, Logo, Motion } from "@prism/chrome.slint";

export { Theme, Motion }

export enum Screen { loading, welcome, options, progress, done, error, confirm }

export struct InstallOptions {
    dir: string,
    desktop: bool,
    autostart: bool,
    launch: bool,
}

export global Setup {
    in property <bool> uninstalling;
    in property <string> app-name: "Prism";
    in property <string> version;
    in-out property <Screen> screen: Screen.loading;
    in-out property <InstallOptions> options;
    in property <string> dir-head;
    in property <string> dir-tail;
    in property <string> install-size;
    in property <string> existing-note;
    in property <bool> upgrade;
    in property <bool> needs-elevation;
    in property <bool> payload-broken;
    in property <string> error;
    in property <string> step;
    in property <float> progress;
    in-out property <bool> remove-data;

    callback start-install();
    callback start-uninstall();
    callback pick-dir();
    callback launch-app();
    callback open-log();
    callback quit();
    callback minimize();
    callback caption-pressed();
}

component Notice inherits Rectangle {
    in property <bool> warning;
    in property <string> text;
    max-width: 448px;
    border-radius: 8px;
    background: root.warning ? Theme.warning-soft : Theme.card.with-alpha(0.7);
    border-width: root.warning ? 0px : 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            Icon {
                source: root.warning ? Icons.shield-alert : Icons.info;
                colorize: root.warning ? Theme.warning : Theme.series-down;
            }
        }
        Label {
            horizontal-stretch: 1;
            text: root.text;
            wrap: word-wrap;
            font-size: 13px;
            line-height: 13px * 1.375;
            color: root.warning ? Theme.foreground : Theme.muted-foreground;
        }
    }
}

component OptionRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);
    padding-top: 10px;
    padding-bottom: 10px;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Label { text: root.title; font-weight: 500; line-height: 20px; }
        if root.text != "": Label { text: root.text; font-size: 12px; line-height: 16px; color: Theme.muted-foreground; }
    }
    VerticalLayout {
        alignment: center;
        Switch {
            label: root.title;
            checked: root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

component StepItem inherits HorizontalLayout {
    in property <int> index;
    in property <int> active;
    in property <string> label;
    property <bool> done: root.index < root.active;
    property <bool> current: root.index == root.active;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        if root.done: Icon { source: Icons.circle-check; colorize: Theme.accent; }
        if root.current: Spinner { size: 16px; tint: Theme.foreground; }
        if !root.done && !root.current: Icon { source: Icons.circle; colorize: Theme.border-strong; }
    }
    Label {
        text: root.label;
        font-size: 13px;
        color: root.done || root.current ? Theme.foreground : Theme.subtle-foreground;
    }
}

component Pop inherits VerticalLayout {
    property <float> shown: 0;
    init => { self.shown = 1; }
    animate shown { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
    opacity: self.shown;
}

component Welcome inherits Pop {
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 80px;
            height: 80px;
            PopShadow {
                x: 4px;
                y: 4px;
                width: 72px;
                height: 72px;
                radius: 16px;
                tint: #0f172a;
                strength: 0.35;
            }
            AnimatedLogo { width: 80px; height: 80px; }
        }
    }
    Rectangle { height: 20px; }
    Label {
        text: Setup.app-name;
        horizontal-alignment: center;
        font-size: 30px;
        line-height: 36px;
        font-weight: 600;
        letter-spacing: -0.75px;
    }
    Rectangle { height: 4px; }
    Label {
        text: "Быстрый VPN-клиент VLESS + Reality для Windows";
        horizontal-alignment: center;
        line-height: 20px;
        color: Theme.muted-foreground;
    }
    if Setup.existing-note != "" || Setup.needs-elevation: VerticalLayout {
        padding-top: 20px;
        spacing: 8px;
        if Setup.existing-note != "": HorizontalLayout {
            alignment: center;
            Notice { text: Setup.existing-note; }
        }
        if Setup.needs-elevation: HorizontalLayout {
            alignment: center;
            Notice {
                warning: true;
                text: "Клиент запущен от имени администратора — Windows попросит подтверждение, чтобы его закрыть.";
            }
        }
    }
    Rectangle { height: 24px; }
    HorizontalLayout {
        alignment: center;
        Button {
            width: 256px;
            height: 44px;
            radius: 12px;
            font-size: 15px;
            kind: ButtonKind.primary;
            text: Setup.upgrade ? "Обновить" : "Установить";
            clicked => { Setup.start-install(); }
        }
    }
    Rectangle { height: 12px; }
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: link.preferred-width;
            height: 28px;
            border-radius: 6px;
            accessible-role: button;
            accessible-label: "Параметры установки";
            accessible-action-default => { Setup.screen = Screen.options; }
            link := HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 14px;
                        height: 14px;
                        source: Icons.settings-alt;
                        colorize: link-touch.has-hover ? Theme.foreground : Theme.muted-foreground;
                    }
                }
                Label {
                    text: "Параметры установки";
                    vertical-alignment: center;
                    font-size: 13px;
                    color: link-touch.has-hover ? Theme.foreground : Theme.muted-foreground;
                }
            }
            link-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { Setup.screen = Screen.options; }
            }
        }
    }
}

component Options inherits Pop {
    width: 448px;
    HorizontalLayout {
        padding-bottom: 12px;
        spacing: 8px;
        Button {
            label: "Назад";
            square: true;
            small: true;
            kind: ButtonKind.ghost;
            icon: Icons.arrow-left;
            clicked => { Setup.screen = Screen.welcome; }
        }
        Label {
            text: "Параметры установки";
            vertical-alignment: center;
            font-size: 18px;
            line-height: 28px;
            font-weight: 600;
        }
    }
    Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.card.with-alpha(0.8);
        VerticalLayout {
            padding-left: 17px;
            padding-right: 17px;
            padding-top: 5px;
            padding-bottom: 5px;
            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                Label { text: "Папка"; font-weight: 500; line-height: 20px; }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.muted;
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 13px;
                            Label {
                                horizontal-stretch: 1;
                                text: Setup.dir-head;
                                font-family: Theme.mono;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Label {
                                text: Setup.dir-tail;
                                font-family: Theme.mono;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Button {
                        small: true;
                        kind: ButtonKind.outline;
                        text: "Изменить";
                        icon: Icons.folder-open;
                        clicked => { Setup.pick-dir(); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            OptionRow {
                title: "Ярлык на рабочем столе";
                checked: Setup.options.desktop;
                toggled(v) => { Setup.options.desktop = v; }
            }
            Rectangle { height: 1px; background: Theme.border; }
            OptionRow {
                title: "Запускать вместе с Windows";
                text: Setup.app-name + " стартует свёрнутым в трей";
                checked: Setup.options.autostart;
                toggled(v) => { Setup.options.autostart = v; }
            }
            Rectangle { height: 1px; background: Theme.border; }
            OptionRow {
                title: "Запустить после установки";
                checked: Setup.options.launch;
                toggled(v) => { Setup.options.launch = v; }
            }
        }
    }
    HorizontalLayout {
        padding-top: 16px;
        Label {
            text: "Понадобится ≈ " + Setup.install-size;
            font-size: 12px;
            vertical-alignment: center;
            color: Theme.subtle-foreground;
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            kind: ButtonKind.primary;
            text: Setup.upgrade ? "Обновить" : "Установить";
            clicked => { Setup.start-install(); }
        }
    }
}

component Progress inherits Pop {
    property <int> active: Setup.step == "extract" ? 0
        : Setup.step == "close" ? 1
        : Setup.step == "replace" ? 2
        : Setup.step == "shortcuts" ? 3
        : Setup.step == "register" ? 4
        : 0;
    property <string> label: Setup.uninstalling ? "Удаляем файлы и ярлыки"
        : root.active == 0 ? "Распаковываем файлы"
        : root.active == 1 ? "Закрываем запущенный клиент"
        : root.active == 2 ? "Заменяем прошлую версию"
        : root.active == 3 ? "Создаём ярлыки"
        : "Регистрируем в системе";
    width: 384px;
    HorizontalLayout {
        alignment: center;
        AnimatedLogo { width: 56px; height: 56px; }
    }
    Rectangle { height: 16px; }
    Label {
        text: Setup.uninstalling ? "Удаляем " + Setup.app-name
            : Setup.upgrade ? "Обновляем " + Setup.app-name
            : "Устанавливаем " + Setup.app-name;
        horizontal-alignment: center;
        font-size: 20px;
        line-height: 28px;
        font-weight: 600;
        letter-spacing: -0.5px;
    }
    Rectangle { height: 20px; }
    Rectangle {
        height: 8px;
        border-radius: 4px;
        background: Theme.muted;
        accessible-role: progress-indicator;
        accessible-value: round(Setup.progress * 100);
        Rectangle {
            x: 0px;
            width: parent.width * max(0.02, Setup.progress);
            border-radius: 4px;
            background: @linear-gradient(90deg, Theme.series-down 0%, Theme.accent 100%);
            animate width { duration: 200ms; easing: ease-out; }
        }
    }
    HorizontalLayout {
        padding-top: 8px;
        Label { text: root.label; font-size: 12px; line-height: 16px; color: Theme.muted-foreground; }
        Rectangle { horizontal-stretch: 1; }
        Label { text: round(Setup.progress * 100) + "%"; tabular: true; font-size: 12px; line-height: 16px; }
    }
    if !Setup.uninstalling: VerticalLayout {
        padding-top: 20px;
        spacing: 6px;
        StepItem { index: 0; active: root.active; label: "Распаковываем файлы"; }
        StepItem { index: 1; active: root.active; label: "Закрываем запущенный клиент"; }
        StepItem { index: 2; active: root.active; label: "Заменяем прошлую версию"; }
        StepItem { index: 3; active: root.active; label: "Создаём ярлыки"; }
        StepItem { index: 4; active: root.active; label: "Регистрируем в системе"; }
    }
}

component Done inherits Pop {
    width: 448px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: Theme.accent-soft;
            Icon { width: 36px; height: 36px; source: Icons.circle-check-bold; colorize: Theme.accent; }
        }
    }
    Rectangle { height: 20px; }
    Label {
        text: Setup.uninstalling ? Setup.app-name + " удалён"
            : Setup.upgrade ? Setup.app-name + " обновлён до " + Setup.version
            : Setup.app-name + " установлен";
        horizontal-alignment: center;
        font-size: 24px;
        line-height: 32px;
        font-weight: 600;
        letter-spacing: -0.6px;
    }
    Rectangle { height: 6px; }
    Label {
        text: Setup.uninstalling
            ? (Setup.remove-data ? "Настройки и подписки тоже удалены." : "Настройки и подписки сохранены — они вернутся при следующей установке.")
            : Setup.options.launch ? Setup.app-name + " запущен — его значок в трее рядом с часами."
            : Setup.app-name + " появился в меню «Пуск».";
        width: 448px;
        horizontal-alignment: center;
        wrap: word-wrap;
        line-height: 20px;
        color: Theme.muted-foreground;
    }
    Rectangle { height: 24px; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if !Setup.uninstalling && !Setup.options.launch: Button {
            height: 40px;
            inset-x: 24px;
            kind: ButtonKind.primary;
            text: "Запустить " + Setup.app-name;
            clicked => { Setup.launch-app(); }
        }
        Button {
            height: 40px;
            inset-x: 24px;
            kind: !Setup.uninstalling && !Setup.options.launch ? ButtonKind.ghost : ButtonKind.primary;
            text: "Готово";
            clicked => { Setup.quit(); }
        }
    }
}

component Failure inherits Pop {
    width: 448px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: Theme.destructive-soft;
            Icon { width: 32px; height: 32px; source: Icons.circle-alert; colorize: Theme.destructive; }
        }
    }
    Rectangle { height: 20px; }
    Label {
        text: Setup.uninstalling ? "Не удалось удалить " + Setup.app-name : "Не удалось установить " + Setup.app-name;
        horizontal-alignment: center;
        font-size: 20px;
        line-height: 28px;
        font-weight: 600;
        letter-spacing: -0.5px;
    }
    Rectangle { height: 6px; }
    TextInput {
        text: Setup.error;
        read-only: true;
        single-line: false;
        wrap: char-wrap;
        horizontal-alignment: center;
        font-family: Theme.sans;
        font-size: 14px;
        line-height-factor: 20 / 14 / 1.21;
        color: Theme.muted-foreground;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.foreground;
    }
    Rectangle { height: 24px; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Button {
            kind: ButtonKind.outline;
            text: "Журнал";
            icon: Icons.scroll-text;
            clicked => { Setup.open-log(); }
        }
        if !Setup.payload-broken: Button {
            kind: ButtonKind.primary;
            text: "Повторить";
            icon: Icons.rotate-cw;
            clicked => {
                if Setup.uninstalling {
                    Setup.start-uninstall();
                } else {
                    Setup.start-install();
                }
            }
        }
    }
}

component Confirm inherits Pop {
    width: 448px;
    HorizontalLayout {
        alignment: center;
        Logo { width: 64px; height: 64px; }
    }
    Rectangle { height: 20px; }
    Label {
        text: "Удалить " + Setup.app-name + "?";
        horizontal-alignment: center;
        font-size: 24px;
        line-height: 32px;
        font-weight: 600;
        letter-spacing: -0.6px;
    }
    Rectangle { height: 6px; }
    Label {
        text: "Приложение закроется, VPN отключится, а прокси Windows вернётся к прежним настройкам.";
        width: 448px;
        horizontal-alignment: center;
        wrap: word-wrap;
        line-height: 20px;
        color: Theme.muted-foreground;
    }
    if Setup.needs-elevation: VerticalLayout {
        padding-top: 16px;
        HorizontalLayout {
            alignment: center;
            Notice {
                warning: true;
                text: Setup.app-name + " запущен от имени администратора — Windows попросит подтверждение.";
            }
        }
    }
    Rectangle { height: 20px; }
    Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.card.with-alpha(0.8);
        HorizontalLayout {
            padding-left: 17px;
            padding-right: 17px;
            padding-top: 13px;
            padding-bottom: 13px;
            spacing: 12px;
            Label {
                horizontal-stretch: 1;
                text: "Удалить также настройки, серверы и подписки";
                vertical-alignment: center;
                line-height: 20px;
            }
            VerticalLayout {
                alignment: center;
                Switch {
                    label: "Удалить также настройки, серверы и подписки";
                    checked: Setup.remove-data;
                    toggled(v) => { Setup.remove-data = v; }
                }
            }
        }
    }
    Rectangle { height: 24px; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Button {
            kind: ButtonKind.ghost;
            text: "Отмена";
            clicked => { Setup.quit(); }
        }
        Button {
            kind: ButtonKind.destructive;
            text: "Удалить";
            clicked => { Setup.start-uninstall(); }
        }
    }
}

component Backdrop inherits Rectangle {
    Rectangle {
        x: 0px;
        y: 28px - 320px;
        width: 640px;
        height: 640px;
        background: @radial-gradient(circle, Theme.series-down.with-alpha(0.18) 0%, Theme.series-down.with-alpha(0.09) 43%, transparent 70.7%);
    }
    Rectangle {
        x: 548px - 190px;
        y: 32px - 190px;
        width: 380px;
        height: 380px;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.12) 0%, Theme.accent.with-alpha(0.05) 42%, transparent 70.7%);
    }
}

export component SetupWindow inherits Window {
    in property <string> window-title;
    title: self.window-title;
    no-frame: true;
    width: 640px;
    height: max(440px, 40px + body.preferred-height);
    background: Theme.background;
    default-font-family: Theme.sans;
    default-font-size: 14px;

    Backdrop { }
    VerticalLayout {
        Rectangle {
            height: 40px;
            DragArea {
                caption-pressed => { Setup.caption-pressed(); }
            }
            HorizontalLayout {
                padding-left: 16px;
                Label {
                    text: Setup.uninstalling ? "Удаление " + Setup.app-name : "Установка " + Setup.app-name + " " + Setup.version;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: Theme.subtle-foreground;
                }
                Rectangle { horizontal-stretch: 1; }
                CaptionButtons {
                    maximizable: false;
                    minimize => { Setup.minimize(); }
                    close => {
                        if Setup.screen != Screen.progress {
                            Setup.quit();
                        }
                    }
                }
            }
        }
        body := VerticalLayout {
            vertical-stretch: 1;
            padding-left: 40px;
            padding-right: 40px;
            padding-bottom: 40px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                if Setup.screen == Screen.welcome: Welcome { }
                if Setup.screen == Screen.options: Options { }
                if Setup.screen == Screen.progress: Progress { }
                if Setup.screen == Screen.done: Done { }
                if Setup.screen == Screen.error: Failure { }
                if Setup.screen == Screen.confirm: Confirm { }
            }
        }
    }
}
